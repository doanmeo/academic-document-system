      "name": "0. Setup & Auth",
      "item": [
        {
          "name": "1. Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Capture adminToken\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.collectionVariables.set(\"adminToken\", jsonData.data.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@cntt.local\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "2. Login Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Capture studentToken\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.collectionVariables.set(\"studentToken\", jsonData.data.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sv01@cntt.local\",\n  \"password\": \"Student@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "3. Setup: Create & Approve Document for Bookmark",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "var docId = jsonData.data.id;",
                  "pm.collectionVariables.set(\"approvedDocId\", docId);",
                  "",
                  "// Step A: Student submit to PENDING",
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get(\"baseUrl\") + \"/documents/\" + docId + \"/submit\",",
                  "    method: 'POST',",
                  "    header: { 'Authorization': 'Bearer ' + pm.collectionVariables.get(\"studentToken\") }",
                  "}, function (err, res) {",
                  "    // Step B: Admin approve to APPROVED",
                  "    pm.sendRequest({",
                  "        url: pm.collectionVariables.get(\"baseUrl\") + \"/admin/documents/\" + docId + \"/approve\",",
                  "        method: 'POST',",
                  "        header: { 'Authorization': 'Bearer ' + pm.collectionVariables.get(\"adminToken\") }",
                  "    }, function (err2, res2) {",
                  "        pm.test(\"Document setup and APPROVED successfully\", function () {",
                  "            pm.expect(res2.code).to.eql(200);",
                  "        });",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Nghiên cứu Kiến trúc Microservices cho Hệ thống Học thuật\",\n  \"abstractText\": \"Tài liệu tổng quan về phân tán hệ thống trong quản trị đồ án...\",\n  \"description\": \"Tài liệu mẫu chuẩn bị cho chức năng bookmark\",\n  \"subjectId\": 1,\n  \"majorId\": 1,\n  \"academicYearId\": 1,\n  \"advisorName\": \"TS. Tran Van B\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": ["{{baseUrl}}"],
              "path": ["documents"]
            }
          }
        },
        {
          "name": "4. Setup: Create DRAFT Document (For Negative Test)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"draftDocId\", jsonData.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Bản nháp chưa duyệt\",\n  \"abstractText\": \"Nội dung nháp...\",\n  \"description\": \"Chưa duyệt\",\n  \"subjectId\": 1,\n  \"academicYearId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": ["{{baseUrl}}"],
              "path": ["documents"]
            }
          }
        }
