                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/{{approvedDocId}}/bookmark",
              "host": ["{{baseUrl}}"],
              "path": ["documents", "{{approvedDocId}}", "bookmark"]
            }
          }
        },
        {
          "name": "4. Verify Bookmark Removed in My Bookmarks",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Bookmark is no longer present\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    var found = jsonData.data.some(function(b) {",
                  "        return b.documentId === Number(pm.collectionVariables.get(\"approvedDocId\"));",
                  "    });",
                  "    pm.expect(found).to.eql(false);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me/bookmarks",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "bookmarks"]
            }
          }
        }
      ]
    },
    {
