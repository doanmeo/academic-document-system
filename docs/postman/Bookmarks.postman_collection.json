                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"Error code is DUPLICATE_BOOKMARK\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(false);",
                  "    pm.expect(jsonData.errors[0].code).to.eql(\"DUPLICATE_BOOKMARK\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
