    },
    {
      "name": "Bookmarks",
      "item": [
        {
          "name": "1. Student Add Bookmark to APPROVED Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Bookmark created successfully\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.documentId).to.eql(Number(pm.collectionVariables.get(\"approvedDocId\")));",
                  "    pm.expect(jsonData.data.document).to.not.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/{{approvedDocId}}/bookmark",
              "host": ["{{baseUrl}}"],
              "path": ["documents", "{{approvedDocId}}", "bookmark"]
            }
          }
        },
        {
          "name": "2. Student View My Bookmarks",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Bookmark list contains added document\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "    pm.expect(jsonData.data.length).to.be.above(0);",
                  "    var found = jsonData.data.some(function(b) {",
                  "        return b.documentId === Number(pm.collectionVariables.get(\"approvedDocId\"));",
                  "    });",
                  "    pm.expect(found).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me/bookmarks",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "bookmarks"]
            }
          }
        },
        {
          "name": "3. Student Remove Bookmark",
          "event": [
            {
              "listen": "test",
