{
  "info": {
    "_postman_id": "b8f4a2c1-9d5e-4e8f-a123-academic-docs-w3-bookmarks",
    "name": "AcademicDocs — Week 3 (Bookmarks API)",
    "description": "Postman Collection for Week 3 (TV3 Scope):\nBookmarks API:\n- POST /api/documents/{id}/bookmark (Bookmark APPROVED document)\n- DELETE /api/documents/{id}/bookmark (Remove bookmark)\n- GET /api/users/me/bookmarks (List bookmarked documents)\n- Negative tests (Duplicate -> 409 Conflict, Non-APPROVED -> 400 Bad Request, Not Found -> 404)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentToken",
      "value": "",
      "type": "string"
    },
