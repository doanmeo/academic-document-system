              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Expected: 200 OK\nHeader: Authorization: Bearer {{accessToken}}\nBody: { refreshToken: '...' }\nEnvelope: { success: true, message: 'Đăng xuất thành công', data: null }"
          },
          "response": []
        }
      ]
    },
    {
