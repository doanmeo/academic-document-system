    {
      "name": "2. Reports Management Flow",
      "item": [
        {
          "name": "1. POST Submit Report (Student on Approved Doc)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Report created with PENDING status\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.status).to.eql('PENDING');",
                  "    if (jsonData.data.id) {",
                  "        pm.collectionVariables.set('reportId', jsonData.data.id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
