            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"COPYRIGHT_VIOLATION\",\n  \"description\": \"Tài liệu có dấu hiệu sao chép chưa ghi nguồn từ đề tài tốt nghiệp khóa trước.\"\n}"
